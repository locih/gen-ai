# Заполните ОДИН из блоков ниже (Cursor или Gemini), второй оставьте закомментированным.
# Проверка: python check_env.py

# --- Cursor API ---
# LLM_PROVIDER=cursor
# CURSOR_API_KEY=
# LLM_MODEL=composer-2.5
# CURSOR_CWD=/path/to/финальный_проект   # опционально

# --- Gemini (OpenAI-compatible) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_AUTH_TOKEN=
# LLM_MODEL=gemini-2.0-flash
